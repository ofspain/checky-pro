# Copy to infra/deploy/.env and fill in. .env and .env.* are gitignored; this file is the only
# one that is committed, and it must never hold a real value.

# --- the public address -----------------------------------------------------
# A hostname you control, with an A record pointing at the stack's PublicIp output.
# The certificate cannot be issued until that record resolves.
PUBLIC_HOST=verify.example.com
ACME_EMAIL=you@example.com

# --- AWS --------------------------------------------------------------------
AWS_REGION=eu-west-1
ECR_REGISTRY=000000000000.dkr.ecr.eu-west-1.amazonaws.com
IMAGE_TAG=latest

# --- database -----------------------------------------------------------------
# Generate each one: openssl rand -base64 24
POSTGRES_PASSWORD=
CRYPTO_APP_PASSWORD=
PAYMENT_APP_PASSWORD=

# --- service-to-service -------------------------------------------------------
# payment-service mints a client_credentials token with this secret to call crypto-service.
# auth-service reads the same variable for its client registration, so one value, both places.
PAYMENT_SERVICE_CLIENT_SECRET=

# --- the chain ----------------------------------------------------------------
# THREE DIFFERENT PROVIDERS. This is the whole point: locally all three are one anvil node, so
# the quorum can never disagree. Here a disagreement is real, and so is HELD.
# Free tiers that work: Alchemy, Infura, Ankr, dRPC.
SEPOLIA_RPC_1=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_RPC_2=https://sepolia.infura.io/v3/YOUR_KEY
SEPOLIA_RPC_3=https://rpc.ankr.com/eth_sepolia/YOUR_KEY

# The one ERC-20 the demo can name. Anything else verifies as UNKNOWN_TOKEN, which shows the
# amount and refuses to name the token - a real outcome worth demonstrating.
# Verify the address on sepolia.etherscan.io before using it; do not copy it from memory.
DEMO_TOKEN_ADDRESS=
DEMO_TOKEN_SYMBOL=USDC
DEMO_TOKEN_DECIMALS=6
