# Copy to infra/deploy/.env and fill in. .env and .env.* are gitignored; this file is the only
# one that is committed, and it must never hold a real value.

# --- the public address -----------------------------------------------------
# A hostname you control, with an A record pointing at the stack's PublicIp output.
# The certificate cannot be issued until that record resolves.
PUBLIC_HOST=verify.example.com
# Optional, and safe to leave empty. Let's Encrypt permits an ACME account with no contact
# address; certificates issue and renew identically and only expiry warning mail is given up.
ACME_EMAIL=

# --- AWS --------------------------------------------------------------------
AWS_REGION=eu-west-1
ECR_REGISTRY=000000000000.dkr.ecr.eu-west-1.amazonaws.com
IMAGE_TAG=latest

# --- database -----------------------------------------------------------------
# Generate each one: openssl rand -base64 24
POSTGRES_PASSWORD=
CRYPTO_APP_PASSWORD=
PAYMENT_APP_PASSWORD=

# --- service-to-service -------------------------------------------------------
# payment-service mints a client_credentials token with this secret to call crypto-service.
# auth-service reads the same variable for its client registration, so one value, both places.
PAYMENT_SERVICE_CLIENT_SECRET=

# From the CDK stack's MfaSeedKekArn output. auth-service envelope-encrypts TOTP seeds with this
# key (ADR-0003) and refuses to start outside the local profile without one.
MFA_SEED_KEK_ARN=

# --- the chain ----------------------------------------------------------------
# THREE DIFFERENT OPERATORS. This is the whole point: locally all three are one anvil node, so
# the quorum can never disagree. Here a disagreement is real, and so is HELD.
#
# TEST THEM FROM THE BOX, NOT FROM YOUR LAPTOP. Two candidates passed here and failed there:
# 1rpc.io returns HTTP 403 "forbidden" to AWS addresses, and sepolia.rpc.thirdweb.com answered
# once then returned 429 with retry-after: 135. The three below each survived 10/10 in a burst
# run from the instance itself. A keyed free tier (Alchemy, Infura) is steadier for anything
# that must not flake mid-demo.
SEPOLIA_RPC_1=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_RPC_2=https://sepolia.gateway.tenderly.co
SEPOLIA_RPC_3=https://api.zan.top/eth-sepolia

# The one ERC-20 the demo can name. Anything else verifies as UNKNOWN_TOKEN, which shows the
# amount and refuses to name the token - a real outcome worth demonstrating.
#
# Verify any address by calling the contract before trusting it, rather than copying it from
# memory; name(), symbol() and decimals() over eth_call take seconds and settle it.
#
# WETH, not USDC, and the reason is what Sepolia traffic looks like: USDC moves almost entirely
# inside swaps where it is not the first transfer in the transaction, so a real USDC transaction
# verifies as UNKNOWN_TOKEN. In those same swaps WETH is the first transfer, so a live
# transaction produces a fully AGREED answer with a readable amount.
# Sepolia USDC is 0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238 (symbol USDC, decimals 6).
DEMO_TOKEN_ADDRESS=0xfff9976782d46cc05630d1f6ebab18b2324d6b14
DEMO_TOKEN_SYMBOL=WETH
DEMO_TOKEN_DECIMALS=18
