# The public surface, and nothing else.
#
# Caddy performs NO ACME here. It serves a pinned Cloudflare Origin CA certificate, valid only
# between Cloudflare's edge and this box, and renews nothing - see the site block below for why,
# and infra/deploy/REBUILD.md for what that means operationally.
#
# This header said the opposite until 2026-11-26, describing automatic Let's Encrypt issuance and
# claiming the box needs port 80 reachable from the internet before first start. Both stopped being
# true when the origin was closed, and the `tls` line below had already stopped doing it.
#
# For a direct-to-origin deployment (`./cdk deploy -c edge=public`), delete that `tls` line and
# Caddy returns to automatic ACME - at which point ACME_EMAIL in .env becomes live again, though
# it is safe to leave empty.

{$PUBLIC_HOST} {
	# Cloudflare Origin CA, not Let's Encrypt. Caddy performs no ACME at all, which is the point:
	# once Cloudflare proxies this hostname and the security group only admits Cloudflare, nothing
	# can reach port 80 from the public internet, so an HTTP-01 renewal would fail - and it would
	# fail at the first RENEWAL, about sixty days after a cutover that looked perfect. This
	# certificate is valid only between Cloudflare's edge and this box, and expires in 2041.
	# Visitors are served Cloudflare's own public certificate, which Cloudflare renews.
	tls /etc/caddy/origin.pem /etc/caddy/origin.key

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# The page loads nothing from anywhere else; its CSS and JS are inline.
		Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}

	handle /api/v1/verifications {
		reverse_proxy payment:8083
	}

	handle /api/v1/verifications/* {
		reverse_proxy payment:8083
	}

	handle /logo.png {
		root * /srv/landing
		file_server
	}

	# The landing page and every receipt link are the same single file.
	handle /r/* {
		root * /srv/landing
		rewrite * /index.html
		file_server
	}

	handle / {
		root * /srv/landing
		rewrite * /index.html
		file_server
	}

	# Everything else - auth, the merchant API, the SPA, actuator - is simply not routed here.
	handle {
		respond "Not found" 404
	}
}
