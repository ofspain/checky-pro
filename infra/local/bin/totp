#!/usr/bin/env python3
"""Print the current 6-digit TOTP code for a secret (from bin/dev-account), and seconds left.

    infra/local/bin/totp <totpSecret>           e.g. code=$(infra/local/bin/totp ABC... | cut -d' ' -f1)
"""
import importlib.machinery, importlib.util, os, sys, time

if len(sys.argv) != 2:
    sys.exit("usage: bin/totp <totpSecret>")
def _load_smoke():
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "smoke")
    loader = importlib.machinery.SourceFileLoader("smoke", path)
    spec = importlib.util.spec_from_loader("smoke", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


smoke = _load_smoke()
print(smoke.totp(sys.argv[1]), f"({30 - int(time.time()) % 30}s left)")
