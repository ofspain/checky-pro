{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://checky.pro/contracts/events/chain/tx-confirmed.v1.schema.json",
  "title": "chain.tx.confirmed (schema_version 1)",
  "description": "Emitted via the outbox exactly once, at the transaction's single CONFIRMATIONS quorum decision (R9). Partition key = watchId. Idempotency key = chain:txHash:confirmed.",
  "type": "object",
  "required": ["idempotencyKey", "watchId", "chain", "txHash", "tokenContractAddress", "confirmations", "occurredAt"],
  "properties": {
    "idempotencyKey": { "type": "string", "description": "chain:txHash:eventtype (L5)." },
    "watchId": { "type": "string", "format": "uuid" },
    "invoiceUuid": { "type": "string", "format": "uuid" },
    "chain": { "type": "string", "enum": ["ETHEREUM", "TRON"] },
    "txHash": { "type": "string" },
    "tokenContractAddress": { "type": "string" },
    "confirmations": { "type": "integer" },
    "occurredAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
