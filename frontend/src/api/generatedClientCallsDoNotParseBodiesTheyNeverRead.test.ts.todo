// ============================================================================================
// INCOMPLETE - PARKED MID-PHASE-6 (task 175). Renamed out of vitest's reach so the suite stays
// green; rename back to `.test.ts` to resume. It is committed rather than discarded because the
// two cases below BOTH FAIL CORRECTLY against the unfixed screens, which is the hard half.
//
// TWO KNOWN BUGS IN THE SCAN ITSELF, both measured:
//
//   1. `auth/codeExchange.ts` is classified `non-reader` and is a READER. Its source is
//      `const { data } = await createOidcClient().POST(...)`, and the statement boundary below
//      uses `lastIndexOf('{', at)` - which lands INSIDE the destructuring `{ data }` and cuts
//      off the `const`, so the `bound` regex never matches. The boundary needs to find a
//      statement start, not the nearest brace.
//   2. `profile/readProfile.ts` and `profile/readAccount.ts` are NOT FOUND AT ALL. They call
//      `api.GET(...)` where `api` is a local binding, so `FACTORIES.test(before)` fails and the
//      `\bapi\.\s*$` fallback does not fire either. The factory has to be traced to the
//      variable, or local client bindings enumerated.
//
// The expected table is the CORRECT answer (3 readers, 3 non-readers all streaming); it is the
// scanner that is wrong, so do not "fix" this by editing the table to match what it finds.
// ============================================================================================

import { readdir, readFile } from 'node:fs/promises';
import { dirname, join, relative } from 'node:path';
import { describe, expect, it } from 'vitest';

/**
 * TASK 175 — a call that does not read the body must not let the library parse it.
 *
 * `openapi-fetch` parses the reply body on its own behalf. For a call whose settle handler never looks at
 * `data`, that parse is pure liability: a reply whose body is not valid JSON makes the promise REJECT with a
 * SyntaxError, and a handler written as `.then(ok, failure)` cannot tell that from a dropped connection.
 * Three screens were written that way and two of them shipped a user-visible bug:
 *
 *   - `ResendVerificationScreen` told a visitor "we could not send that" about an email the server had sent
 *     (task 51).
 *   - `VerifyScreen` told a visitor whose verification SUCCEEDED that their link was not valid (task 175).
 *   - `RegisterScreen` left the form unchanged, so the visitor saw nothing happen and would submit a second
 *     registration for an address the server had already accepted (task 175).
 *
 * All three were invisible to the whole suite, because the contract declares `204` and `202` and every
 * fixture answers the way the contract says. THIS FILE EXISTS SO THE FOURTH ONE IS NOT WRITTEN.
 *
 * WHY THE RULE IS NOT "ALWAYS PASS parseAs" - three calls legitimately READ the body, and for them a parse
 * failure IS a failure: no token, no profile, no account. A blanket rule would break them, and a blanket ban
 * would let the defect back. The invariant is narrower than either: IF YOU DO NOT READ THE BODY, DO NOT LET
 * THE LIBRARY PARSE IT.
 *
 * AND THIS SCAN ASSERTS ITS OWN CENSUS. The expected table below names every call site, its classification
 * and whether it passes the option, so a scan that silently stopped finding anything would FAIL rather than
 * pass - which is the failure mode a pattern-based scan has by default, and which task 36 found in a scan it
 * had added one phase earlier.
 */

const SRC = dirname(dirname(new URL(import.meta.url).pathname));

/** Every factory in the bundle. `createOidcClient` is here because task 175's phase 3 design enumerated only
 *  the two auth factories and would therefore have missed `codeExchange` entirely - the one call site whose
 *  misclassification would have broken the sign-in flow. */
const FACTORIES = /create(PublicAuthApi|AuthApi|OidcClient)\s*\(/;

type Site = { file: string; method: string; kind: 'reader' | 'non-reader'; streams: boolean };

async function productionFiles(dir: string): Promise<string[]> {
  const out: string[] = [];
  for (const entry of await readdir(dir, { withFileTypes: true })) {
    const full = join(dir, entry.name);
    if (entry.isDirectory()) out.push(...(await productionFiles(full)));
    else if (/\.tsx?$/.test(entry.name) && !/\.test\.tsx?$/.test(entry.name)) out.push(full);
  }
  return out;
}

const stripComments = (source: string) =>
  source.replace(/\/\*[\s\S]*?\*\//g, '').replace(/(?<!:)\/\/[^\n]*/g, '');

/** Collects one row per generated-client call. The statement is taken from the call back to the nearest
 *  statement boundary and forward to the end of the chain, because the two things that classify a call - an
 *  `await` binding BEFORE it and a `.then` AFTER it - sit on opposite sides. */
function sitesIn(file: string, source: string): Site[] {
  const code = stripComments(source);
  const sites: Site[] = [];
  for (const match of code.matchAll(/\.(POST|GET|PUT|PATCH|DELETE)\s*\(/g)) {
    const at = match.index;
    const statementStart = Math.max(0, code.lastIndexOf(';', at), code.lastIndexOf('{', at));
    const before = code.slice(statementStart, at);
    if (!FACTORIES.test(before) && !/\bapi\.\s*$/.test(before.slice(-8))) continue;
    const end = code.indexOf(';', at);
    const statement = code.slice(statementStart, end === -1 ? code.length : end);

    // A READER binds the result or names `data` in a settle handler. BOTH SHAPES MATTER: all three readers
    // in this bundle use `await`, not `.then`, so a scan that only inspected `.then` callbacks would have
    // classified every one of them as a non-reader and demanded the option on exactly the calls that must
    // not have it.
    const bound = /\b(?:const|let|var)\s+(?:\{[^}]*\}|\w+)\s*=\s*await\b/.test(statement);
    const namesData = /\.then\s*\(\s*(?:\(\s*\{[^}]*\bdata\b|async\s*\(\s*\{[^}]*\bdata\b)/.test(statement);
    sites.push({
      file: relative(SRC, file),
      method: match[1]!,
      kind: bound || namesData ? 'reader' : 'non-reader',
      streams: /parseAs:\s*'stream'/.test(statement),
    });
  }
  return sites;
}

describe('generatedClientCallsDoNotParseBodiesTheyNeverRead', () => {
  it('finds every generated-client call, and the census is ASSERTED so an empty scan fails (AC10)', async () => {
    const files = await productionFiles(SRC);
    const sites = (await Promise.all(files.map(async (f) => sitesIn(f, await readFile(f, 'utf8')))))
      .flat()
      .sort((a, b) => a.file.localeCompare(b.file));

    // THE WHOLE TABLE IS THE ASSERTION. It pins the census, every classification and every option in one
    // comparison, so adding a call site, moving one, or changing what one reads all break this case and have
    // to be argued for. A separate `toHaveLength` would let a new non-reading call in as long as someone
    // bumped the number.
    expect(sites, 'the set of generated-client calls changed - every row here is a decision').toEqual([
      // THE THREE READERS, exempt because for them a parse failure IS a failure.
      { file: 'auth/codeExchange.ts', method: 'POST', kind: 'reader', streams: false },
      { file: 'features/account/RegisterScreen.tsx', method: 'POST', kind: 'non-reader', streams: true },
      { file: 'features/account/ResendVerificationScreen.tsx', method: 'POST', kind: 'non-reader', streams: true },
      { file: 'features/account/VerifyScreen.tsx', method: 'POST', kind: 'non-reader', streams: true },
      { file: 'profile/readAccount.ts', method: 'GET', kind: 'reader', streams: false },
      { file: 'profile/readProfile.ts', method: 'GET', kind: 'reader', streams: false },
    ]);
  });

  it('holds the invariant itself, so a new non-reading call fails even if the table above is edited', async () => {
    const files = await productionFiles(SRC);
    const sites = (await Promise.all(files.map(async (f) => sitesIn(f, await readFile(f, 'utf8'))))).flat();

    expect(sites.length, 'the scan found no generated-client calls at all, so it is measuring nothing')
      .toBeGreaterThan(3);

    const offenders = sites.filter((s) => s.kind === 'non-reader' && !s.streams)
      .map((s) => `${s.file} (${s.method})`);
    expect(offenders, "a call that never reads the body lets openapi-fetch parse it, so a reply that is not "
      + "valid JSON will reach its failure arm and the visitor will be told the request failed when it did not")
      .toEqual([]);
  });
});
